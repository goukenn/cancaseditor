$def['.ce-mobile div.tool.t'] = 'display:none!important;';
$def['.ce-burger'] = 'display:none;position:absolute;left:8px;top:8px;z-index:120;width:36px;height:36px;padding:0;border:0;border-radius:6px;background:rgba(40,40,40,.85);color:#eee;cursor:pointer;box-shadow:0 0 4px rgba(0,0,0,.5);';
$def['.ce-mobile .ce-burger'] = 'display:block;';
$def['.ce-burger svg'] = 'width:22px;height:22px;margin:7px;';
$def['.ce-drawer'] = 'position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,.5);font:16px system-ui,sans-serif;';
$def['.ce-drawer .ce-panel'] = '{sys:no-selection} position:absolute;left:0;top:0;bottom:0;width:min(320px,86vw);background:#2b2b2b;color:#eee;overflow:hidden;touch-action:pan-y;box-shadow:0 0 12px #000;';
$def['.ce-drawer .ce-page'] = 'position:absolute;inset:0;overflow-y:auto;background:#2b2b2b;transition:transform .22s ease;';
$def['.ce-drawer .ce-page.ce-under'] = 'transform:translateX(-30%);';
$def['.ce-drawer .ce-page.ce-in'] = 'transform:translateX(100%);';
$def['.ce-drawer .ce-head'] = 'display:flex;align-items:center;gap:8px;padding:12px;background:#1e1e1e;font-weight:bold;position:sticky;top:0;';
$def['.ce-drawer .ce-head button'] = 'background:transparent;border:0;color:inherit;font-size:20px;cursor:pointer;padding:0 6px;';
$def['.ce-drawer .ce-item'] = 'display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid #383838;cursor:pointer;';
$def['.ce-drawer .ce-item .ce-label'] = 'flex:1;';
$def['.ce-drawer .ce-item .ce-more'] = 'opacity:.6;';
$def['.ce-drawer .ce-item.ce-off'] = 'opacity:.35;pointer-events:none;';
$def['.ce-drawer .ce-item:active'] = 'background:#4c448f;';
$def['[data-theme="light"] .ce-drawer .ce-panel, [data-theme="light"] .ce-drawer .ce-page'] = 'background:#e4e8e6;color:#111;';
$def['[data-theme="light"] .ce-drawer .ce-head'] = 'background:#cfd8d4;';
$def['[data-theme="light"] .ce-drawer .ce-item'] = 'border-color:#c3c9c6;';

// + | ---------------------------------------------------------------------------
