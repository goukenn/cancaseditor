$editor = '.igk-cancas-editor-app';
$menuZIndex = 100;
$snippetZIndex = 10;
$snippets = array(
'size'=>'10',
'touch_size'=>'16'
);
$root['--ce-menu-font-size'] = '12pt';
$var = function($n, $def='')use(& $root){
	$h = igk_getv($root, '--'.$n) ?? $def;
	return "var(--{$n}, {$h})";
};
$root["--igk-background-color"] = "#444";
$root["--igk-cancas-editor-app_menu-height"] = "32px";
$root["--ce-input_background-color"] = "#eee";
if ($theme_name){
	include(__DIR__.'/themes/'.$theme_name.'.theme.pcss'); 
}
$def["{$editor}"] = "{sys:fit, posr, no-overflow, no-selection}  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif; overscroll-behavior: none; background-color: var(--igk-cancas-editor-app_background, #444); padding-left: 32px; padding-bottom : var(--igk-cancas-editor-app_menu-height, 32px)";
$def["{$editor} div.tool.t .menu .submenu li > a .shortcut"] = "float: right; margin-left: 2.5em; opacity: .6; font-size: .85em;";
