/**
 * @var string $theme_name
 * @var mixed $theme
 */

$editor = '.igk-cancas-editor-app';
$menuZIndex = 100;
$snippetZIndex = 10;
$snippets = array(
'size'=>'10',
'touch_size'=>'16'
);
$root['--ce-menu-font-size'] = '12pt';
$var = function($n, $def='')use(& $root){
	$h = igk_getv($root, '--'.$n) ?? $def;
	return "var(--{$n}, {$h})";
};
$root["--igk-background-color"] = "#444";
$root["--igk-cancas-editor-app_menu-height"] = "32px";
$root["--ce-input_background-color"] = "#eee";
if ($theme_name){
	include(__DIR__.'/themes/'.$theme_name.'.theme.pcss'); 
}
$def["{$editor}"] = "{sys:fit, posr, no-overflow, no-selection}  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif; overscroll-behavior: none; background-color: var(--igk-cancas-editor-app_background, #444); padding-left: 32px; padding-bottom : var(--igk-cancas-editor-app_menu-height, 32px)";
$def["{$editor} div.tool.t .menu .submenu li > a .shortcut"] = "float: right; margin-left: 2.5em; opacity: .6; font-size: .85em;";
$xsm_screen["{$editor} div.tool.t .menu .submenu li > a .shortcut"] = $sm_screen["{$editor} div.tool.t .menu .submenu li > a .shortcut"] = "display: none;";
$def["{$editor}.touchable-device div.tool.t .menu .submenu li > a .shortcut"] = "display: none;";
$def["{$editor} .surface .ce-cursor"] = "position: absolute; right: 10px; bottom: 8px; padding: 2px 10px; border-radius: 10px; background: rgba(0,0,0,.45); color: #eee; font-size: 11px; pointer-events: none; z-index: 5;";
$def["{$editor} .surface .ce-cursor:empty"] = "display: none;";
$xsm_screen["{$editor} .surface .ce-cursor"] = $sm_screen["{$editor} .surface .ce-cursor"] = "display: none;";
$def["{$editor}.touchable-device .surface .ce-cursor"] = "display: none;";
$def["{$editor} .surface:focus"] = "outline: none;";
$def["{$editor} canvas:not(.posab)"] = "background-color: var(--ce-surface-bg-color); position:relative;";
$def["{$editor} div.tool"] = "{sys:posab}";
$def["{$editor} div.b"] = "{sys:posab, loc-b, loc-l, loc-r} font-size: 8pt; color:#ddd; line-height:32px; vertical-align:middle;";
$def["{$editor} div.tool.t"] = "{sys:loc-t, loc-l, loc-r, no-selection} background-color: #444; z-index:{$menuZIndex}; padding-left:32px;";
$def["{$editor} div.tool.t .menu"] = "font-size: var(--ce-menu-font-size, 12pt); {sys:dispib, no-wrap} vertical-align:middle; /*for ie explorer*/ line-height: 32px; line-height:var(--igk-cancas-editor-app_menu-height, 32px);"; 
$def["{$editor} div.tool.t .menu li"] = "{sys:dispib}";
$def["{$editor} div.tool.t .menu li.igk-hide"] = "display:none !important;";
$def["{$editor} div.tool.t .menu li.igk-disable a"] = "color:#555; background-color:#111;";
$def["{$editor} div.tool.t .menu li.igk-disable a:hover"] = "color:#555; background-color:var(--ce-menu-bg-color, rgba(30,200,180, 0.7));";
$def["{$editor} div.tool.t .menu > li:not(:first-child)"] = "margin-left: 4px";
$def["{$editor} div.tool.t .menu li > a"] = "{sys:dispb} color:#ddd; cursor:pointer; min-width:32px; padding: 0px 4px; font-size: 0.9em; ";
$def["{$editor}:not(.touchable-device) div.tool.t .menu li > a:hover"] = "color:#eee; background-color: #4c448f";
$def["{$editor} div.tool.t .menu .submenu"]= "{sys:posab, dispn} backdrop-filter: blur(40px); opacity:0; box-shadow: 0 0 6px black; border-radius:4px; background-color: [cl:--ce-menu-bg-color, transparent]; ";
$def["{$editor} div.tool.t .menu .submenu > li:first-child > a"]= "{sys:no-overflow} border-radius: 4px 4px 0px 0px;"; 
$def["{$editor} div.tool.t .menu .submenu > li:last-child > a"]= "{sys:no-overflow} border-radius: 0px  0px 4px 4px;"; 
$def["{$editor} div.tool.t .menu .submenu .sub_2"]= "left: 100%; top:0px;"; 
$def["{$editor} div.tool.t .menu .submenu > li"]= "{sys:dispb, posr} "; 
$def["{$editor} div.tool.t .menu .submenu > li a"]= "padding-left: 48px; padding-right:64px;"; 
$def["{$editor} div.tool.t .menu .submenu > li.checked > a::before"]= "content: '\\2713'; position: absolute; left: 18px; font-weight: bold;";
$xsm_screen[$editor] =
$sm_screen[$editor] = 'padding: 0;';
$def["{$editor} div.tool.t .logo"] = "{sys:no-overflow} cursor: pointer; [trans:.2s background-color ease-in] background-color:var(--cc-editor-logo-bg); width: 32px; height:100%; text-indent: -9999px;";
$def["{$editor} div.tool.t .logo:hover"] = "background-color:indigo;";
// + | --------------------------------------------------------------------
// + | ce - left tool bar
// + |
$def[$editor.' div.tool.l']='inset: 0px 32px 32px 0px; width: 32px; background-color: var(--cc-editor-bar);';
$xsm_screen[$editor.' div.tool.l']=
$sm_screen[$editor.' div.tool.l']='{sys:dispn}';
$def["{$editor}:not(.touchable-device) div.tool.t .menu li:hover > .submenu"]= 
$def["{$editor}.touchable-device div.tool.t .menu li.igk-show > .submenu"]= 
"{sys:dispb} opacity:1;"; 
$def["{$editor}:not(.touchable-device) div.tool.t .menu li:hover > .submenu.igk-hide"]= "opacity:0.2; display:none;"; 
$def["{$editor}.touchable-device .igk-show"] = "background-color:red";
$def["{$editor}.touchable-device .igk-show > ul"] = "{sys:dispb} opacity:1;";
$def[".xsm {$editor} div.tool.t"] =
$def[".sm {$editor} div.tool.t"] = "{sys:dispn}";
$def[".xsm {$editor}"] = 
$def[".sm {$editor}"] = 
"padding-top:0px;"; 
$def["{$editor} div.tool.b"] = "{sys:no-selection}";
$def["{$editor} .layerview"] = "padding-left: 16px; line-height:1; border:1px solid black; text-indent: -10px; max-height:230px; overflow-y:auto;";
$def["{$editor} .layerview > li.igk-active"] = "list-style-type: disc";
$def["{$editor} .layerview > li"] = "position:relative; list-style-type: none; padding: 10px;";
$def["{$editor} .layerview > li:hover"] = 
$def["{$editor} .layerview > li:hover:before"] = 
"background-color:indigo;";
$def["{$editor} .layerview > li:before"] = "z-index:-1; left:-16px; top:0px; width:16px; height:100%; position:absolute; content:' ';";
$def["{$editor} hr"]= "margin:0px 4px; border:0px; border-bottom: 1px #555 solid;";
$def["{$editor} .colortool"] = "display:inline-block; vertical-align:middle; line-height:0; position:relative; ";
$def["{$editor} .colortool > .btn:first-child"] = "position:relative; margin-left:4px;";
$def["{$editor} .colortool .btn"] = "display:inline-block; width:16px; height:16px; border:1px solid black; background-color:white; ";
$def["{$editor} .colortool .btn.stroke"] = "{sys: posr} left: -4px; top: 4px; background-color:red;";
$def["{$editor}.touchable-device"] = "{sys:fith} padding:0px; padding-top:36px; padding-bottom: var(--igk-cancas-editor-app_menu-height, 32px);";
$def["{$editor}.touchable-device canvas"] = "overflow:scroll; padding-top:10px;";
$def["{$editor}.touchable-device div.tool.b"]= "{sys:dispn};"; 
$def[".pageLayer-contextMenu"] = "{sys:no-overflow} [trans: opacity 0.5s ease-out]; opacity: 1.0; z-index:110; top:0px; left: 100px; background-color: #444; [resolv: box-shadow: 0px 0px 4px]; border-radius: 10px;";
$def[".pageLayer-contextMenu:before"] = "{sys:posfix, loc-a} content:' '; opacity: 0.2; z-index: -1; background-color:black;";
$def[".pageLayer-contextMenu a"] = "{sys:dispb} padding: 10px 4px; padding-left: 32px;  font-size: 0.9em; cursor:pointer;";
$def[".pageLayer-contextMenu li"] = "{sys:dispb}";
$def[".pageLayer-contextMenu li:hover > a"] = "background-color: indigo; color:white; ";
$def[".pageLayer-contextMenu.igk-hide"] = "opacity: 0.0;"; 
$def[".canvas-editor-gui_dialog"] = "{sys:posfix, loc-a, dispflex} justify-content:center; align-items:center; z-index: 100;";
$def[".canvas-editor-gui_dialog:before"] = "{sys:posab, fit, loc-t, loc-l} content:' '; background-color:#222; opacity: 0.4; ";
$def[".canvas-editor-gui_dialog > div.box"] =  "{sys:dispib, loc-t} background-color: #fcfcfc; border:1px solid #dedede; ".
" box-shadow: 0 0 10px black;".
" padding:10px; border-radius: 10px; ";
$def[".canvas-editor-gui_dialog .title-bar"] = "font-family: [var: --igk-winui-bmc-typo]; {sys:no-selection}";
$def[".canvas-editor-gui_dialog .title-bar .close"] = "cursor: pointer;";
$def[".canvas-editor-gui_dialog .box .content"] = "min-width:300px; line-height:1;";
$def["body > .dialog .igk-winui-bmc-group > div"] = "margin:4px 0px;";
$theme->registerKeyFrame($def, "igk-cancas-editor_notify-anim", " from { left: 50%; } to {left: 0px; }");
$def[".igk-cancas-editor_notifyhost"]="{sys:posab} right:0px; top:0px;";
$def[".igk-cancas-editor_notify"] = "(:.no-selection) [trans:opacity 0.2s ease-in, box-shadow 0.5s] [anim:igk-cancas-editor_notify-anim 0.2s linear]".
"opacity: 0.7; right:0; top: 0px; background-color:#444; line-height: 4em; color:#eee; padding:10px; padding-left:48px; margin-right: 10px; margin-top:10px; border-radius: 4px; ";
$def[".igk-cancas-editor_notify:hover"] = "opacity : 1.0; box-shadow: 0 0 6px black;";
$def[".igk-cancas-editor_notify.igk-hide"] = "opacity : 0.0;";
$PTR["{$editor}"] = "display:none !important;";
$PTR[".igk-cancas-editor-options"] = "display:none !important;";
$def["{$editor}.touchable-device .snippet"] = "[transform:scale({$snippets['touch_size']},{$snippets['touch_size']})]";
$def["{$editor} .snippet"] = "{sys:posab}; cursor:pointer; z-index:{$snippetZIndex}; opacity: 0.5; [trans: opacity 0.2s ease-out];  width:1px; height:1px; transform-origin:center;".
" [transform: scale(10,10)]; background-color:skyblue; ";
$def["{$editor} .snippet:hover"]= "opacity:1.0; ";
$def["{$editor} .snippet.igk-hide"] = "opacity: 0.0;";
$def["{$editor} .snippet.round"] = "border-radius: 50%";
// transform snippets (selection): square = scale, diamond = skew, round + orange = rotation; they grow on hover
$def["{$editor} .snippet.rotate"] = "background-color: orange; cursor: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2224%22 height=%2224%22 viewBox=%220 0 24 24%22><path d=%22M5 15a8 8 0 0 1 3-8.5M19 15a8 8 0 0 0-3-8.5%22 fill=%22none%22 stroke=%22white%22 stroke-width=%225%22 stroke-linecap=%22round%22/><path d=%22M2.5 11l3.5 6 4-5zM21.5 11l-3.5 6-4-5z%22 fill=%22white%22 stroke=%22white%22 stroke-width=%223%22 stroke-linejoin=%22round%22/><path d=%22M5 15a8 8 0 0 1 3-8.5M19 15a8 8 0 0 0-3-8.5%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22 stroke-linecap=%22round%22/><path d=%22M2.5 11l3.5 6 4-5zM21.5 11l-3.5 6-4-5z%22 fill=%22black%22/></svg>') 12 12, grab;";
$def["{$editor} .snippet.square, {$editor} .snippet.round"] = "[trans: opacity 0.2s ease-out, transform 0.15s ease-out]";
$def["{$editor}:not(.touchable-device) .snippet.square:hover, {$editor}:not(.touchable-device) .snippet.round:hover"] = "[transform: scale(13,13)]";
$def["{$editor} .snippet.losange"] = "[transform: rotate(45deg) scale(8)] width:1px; height:1px;";
$trans = $snippets['size']/ 2;
$def["body.safari .snippet" ] = "width:{$snippets['size']}px; height:{$snippets['size']}px;  [transform:translate(-{$trans}px, -{$trans}px)]";
$trans = $snippets['touch_size']/ 2;
$def["body.safari {$editor}.touchable-device .snippet" ] = "width:{$snippets['touch_size']}px; height:{$snippets['touch_size']}px; [transform:translate(-{$trans}px, -{$trans}px)] ";
$def["body.safari .snippet.round" ] = "";
$def["div.igk-default"] = "background-color: red; height: 800px;";
$def["div.canvas-editor-gui_dialog.dialog.color:before"] = "background-color:transparent; opacity:0.0;";
$def[".igk-tab-button"] = "{sys:dispib} font-size:0.62em";
$def[".igk-tab-button .igk-btn"] = "background-color:#444;{sys:no-selection}";
$def[".igk-tab-button .igk-btn.igk-active"] = "background-color:#eee; color:#444;";
$def[".igk-tab-button .igk-btn:hover"] = "background-color:indigo; color:white";
$def[".igk-tab-button .igk-btn:first-child"] = "border-radius: 4px 0 0 4px;";
$def[".igk-tab-button .igk-btn:last-child"] = "border-radius: 0 4px 4px 0;";
$def[".igk-color-value-label"] = "border-radius:4px; background-color:{$var('ce-input_background-color')}; padding:4px; width:auto;";
$def[".igk-color-value-label > input"] = "{sys:alignc, no-border, dispb, fitw}  background-color:transparent;";
$def[".rgb-color-picker"] = "{sys: dispib} line-height: 0; border-radius: 50%; border:none;";
$def[".rgb-color-picker > img"] = "{sys:dispib} border-radius: 50%; border:none;";
$def[".rgb-color-picker .btn-cur"] = "{sys:posab} left:50%;top:50%; width:4px; height:4px; padding:1px; border:none; background-color:transparent; [transform:translate(-2px, -2px)]";
$def[".rgb-color-picker .btn-cur:before"] = "{sys:posab, dispb, fit } content:' '; background-color:black;";
$def[".ce-color-track"] = "{sys:no-wrap} margin-bottom:4px; ";
$def[".ce-color-track .igk-round-input"] = "{sys:dispib} margin-left:1em; padding:4px; border-radius: 4px; background-color:{$var('ce-input_background-color')}";
$def[".ce-color-track .igk-round-input > input"] = "{sys:alignc,no-border, no-background} width:2em;";
$def["div.input-field__track-value"] = "{sys:posab} background-color: #444; [resolv:user-select: none;] height:4px; left:0px; bottom:0px;";
$def["body.igk-body"] = "{sys:fit} overscroll-behavior: none; touch-action:none;";
$xsm_screen["{$editor} div.tool.t"] = $sm_screen["{$editor} div.tool.t"] =  "display:none;";


$root['--cc-editor-bar'] = '#444';
$root['--cc-editor-logo-bg'] = '#333';

// + | ---------------------------------------------------------------------------
// + | property inspector (docked right on wide screens, see tools/PropertyInspectorTool.js)
// + |
$def["{$editor}.ci-docked"] = "padding-right: 280px;";
$def["{$editor} div.tool.r"] = "top: var(--igk-cancas-editor-app_menu-height, 32px); right: 0px; bottom: var(--igk-cancas-editor-app_menu-height, 32px); width: 280px; box-sizing: border-box; background-color: var(--cc-editor-bar); color: #ddd; overflow-y: auto; z-index: 50; display: none; font-size: 9pt;";
$def["{$editor} div.tool.r.ci-visible"] = "display: block;";
$def["{$editor} .ci-head"] = "display: flex; align-items: center; padding: 4px 8px; background-color: #333; font-weight: bold; position: sticky; top: 0px; z-index: 1;";
$def["{$editor} .ci-head-title"] = "flex: 1;";
$def["{$editor} .ci-close"] = "background: transparent; border: 0px; color: #ddd; font-size: 16px; cursor: pointer;";
$def["{$editor} .ci-body"] = "padding: 8px;";
$def["{$editor} .ci-title"] = "font-weight: bold; margin-bottom: 8px; opacity: 0.8;";
$def["{$editor} .ci-fab"] = "position: absolute; right: 8px; bottom: calc(var(--igk-cancas-editor-app_menu-height, 32px) + 8px); z-index: 60; padding: 8px 14px; border: 0px; border-radius: 18px; background-color: indigo; color: #fff; cursor: pointer; box-shadow: 0 0 6px black;";
$def["{$editor} .ci-panel input, {$editor} .ci-panel select"] = "max-width: 100%; box-sizing: border-box;";
$def[".cancas-modal .ci-title"] = "font-weight: bold; margin-bottom: 8px;";
// + | ---------------------------------------------------------------------------
// + | status bar (div.tool.b, see tools/StatusBarTool.js)
// + |
$def["{$editor} div.tool.b"] = "{sys:no-selection} top: auto; bottom: 0px; height: var(--igk-cancas-editor-app_menu-height, 32px); display: flex; align-items: center; padding: 0px 4px; white-space: nowrap; border-top: 1px solid #666;";
$def["{$editor} div.tool.b .sb"] = "display: inline-flex; align-items: center; gap: 12px; padding-left: 8px; margin-right: 12px;";
$def["{$editor} div.tool.b .sb-seg"] = "white-space: nowrap; flex: none;";
$def["{$editor} div.tool.b .sb-seg:empty"] = "display: none;";
$def["{$editor} div.tool.b .sb-warn"] = "color: #f0b429;";
$def["{$editor} div.tool.b .sb-cursor"] = "min-width: 7em;";
$xsm_screen["{$editor} div.tool.b .sb-opt"] = $sm_screen["{$editor} div.tool.b .sb-opt"] = "display: none;";
$def["{$editor}.touchable-device div.tool.b"] = "display: flex;";

// + | ---------------------------------------------------------------------------
// + | light theme (the dark one is the default). Attribute set on <html> by tools/SettingsDialog.js
// + |
$def["[data-theme=\"light\"] {$editor}"] = "--igk-cancas-editor-app_background: #e9ecea; --cc-editor-bar: #d3d8d5; --ce-surface-bg-color: #f5f5f5; color: #222;";
$def["[data-theme=\"light\"] {$editor} div.tool.t"] = "background-color: #d3d8d5;";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu li > a"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor}:not(.touchable-device) div.tool.t .menu li > a:hover"] = "color: #fff;";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu .submenu"] = "background-color: rgba(245,247,246,.98) !important; border: 1px solid rgba(0,0,0,.2); box-shadow: 0 6px 18px rgba(0,0,0,.25);";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu li.igk-disable a"] = "color: #888; background-color: transparent;";
$def["[data-theme=\"light\"] {$editor} div.b"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor} div.tool.r"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor} .ci-head"] = "background-color: #c4cac7;";
$def["[data-theme=\"light\"] {$editor} .ci-close"] = "color: #222;";


$def[$editor.' .ce-drawer .ce-panel'] = '{sys:no-selection}';
$def['.ce-drawer .ce-panel'] = '{sys:no-selection}';
