// + |
$def['.cancas-html-dlg'] = 'position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);font:14px sans-serif;';
$def['.cancas-html-dlg>div'] = 'background:#2b2b2b;color:#eee;width:min(960px,94vw);height:min(720px,90vh);display:flex;flex-direction:column;border-radius:6px;overflow:hidden;';
