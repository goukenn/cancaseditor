// + | ---------------------------------------------------------------------------
// + | page designer (tools/PageDesigner.js)
// + |
$def['.pd-root'] = 'margin-top:10px;font-size:12px;';
$def['.pd-h'] = 'font-weight:bold;margin:10px 0 4px;opacity:.85;';
$def['.pd-pal'] = 'display:flex;flex-wrap:wrap;gap:4px;';
$def['.pd-pal button'] = 'padding:2px 7px;border:1px solid var(--ci-line,#4a4a4a);border-radius:10px;background:transparent;color:inherit;cursor:pointer;font:11px monospace;';
$def['.pd-pal button:hover'] = 'background:rgba(127,127,127,.25);';
$def['.pd-tree'] = 'border:1px solid var(--ci-line,#4a4a4a);border-radius:4px;padding:2px;max-height:240px;overflow:auto;outline:none;';
$def['.pd-tree:focus'] = 'border-color:var(--ci-accent,#a14fd0);';
$def['.pd-row'] = 'display:flex;align-items:center;gap:2px;padding:1px 2px;border-radius:3px;cursor:pointer;white-space:nowrap;';
$def['.pd-row:hover'] = 'background:rgba(127,127,127,.18);';
$def['.pd-row.sel'] = 'background:rgba(161,79,208,.35);';
$def['.pd-row .lb'] = 'flex:1;min-width:44px;overflow:hidden;text-overflow:ellipsis;';
$def['.pd-row .tx'] = 'opacity:.6;max-width:44px;overflow:hidden;text-overflow:ellipsis;';
$def['.pd-row button'] = 'border:0;background:transparent;color:inherit;cursor:pointer;padding:0 2px;opacity:.7;font-size:11px;';
$def['.pd-row button:hover'] = 'opacity:1;';
$def['.pd-ed label'] = 'display:block;margin:6px 0 2px;opacity:.7;';
$def['.pd-ed input, .pd-ed textarea'] = 'width:100%;box-sizing:border-box;background:var(--ci-input,#111);color:inherit;border:1px solid var(--ci-line,#4a4a4a);border-radius:3px;padding:3px 5px;font:12px monospace;';
$def['.pd-root select'] = 'width:100%;background:var(--ci-input,#111);color:inherit;border:1px solid var(--ci-line,#4a4a4a);border-radius:3px;padding:3px;';
$def['.pd-empty'] = 'opacity:.6;padding:6px;';

// + | ---------------------------------------------------------------------------
// + | inspector panel (tools/InspectorPanel.js)
// + |
$root['--ci-fg'] = '#ddd';
$root['--ci-dim'] = '#9a9a9a';
$root['--ci-input'] = '#222';
$root['--ci-line'] = '#4a4a4a';
$root['--ci-pop'] = '#2e2e2e';
$root['--ci-accent'] = '#a14fd0';
$def['[data-theme="light"]'] = '--ci-fg:#222;--ci-dim:#6b6b6b;--ci-input:#fff;--ci-line:#b9bfbc;--ci-pop:#f4f4f4;--ci-accent:#7d3cc2;';
$def['.ci-root'] = 'color:var(--ci-fg);font-size:12px;';
$def['.ci-root input[type=number], .ci-root input[type=text], .ci-root select'] = 'width:100%;box-sizing:border-box;background:var(--ci-input);color:var(--ci-fg);border:1px solid transparent;border-radius:5px;padding:6px 8px;font:inherit;min-width:0;';
$def['.ci-root input:focus, .ci-root select:focus'] = 'outline:none;border-color:var(--ci-accent);';
$def['.ci-root input[type=range]'] = 'width:100%;accent-color:var(--ci-accent);';
$def['.ci-root button:not(.ci-ico):not(.ci-swatch):not(.be-stop)'] = 'background:var(--ci-input);color:var(--ci-fg);border:1px solid var(--ci-line);border-radius:5px;padding:5px 10px;cursor:pointer;font:inherit;';
$def['.ci-root button:not(.ci-ico):not(.ci-swatch):not(.be-stop):hover'] = 'border-color:var(--ci-accent);';
$def['.ci-bar'] = 'display:flex;justify-content:space-between;padding:4px 2px 10px;';
$def['.ci-ico'] = 'background:transparent;border:0;color:var(--ci-fg);width:26px;height:26px;padding:3px;border-radius:4px;cursor:pointer;line-height:0;';
$def['.ci-ico:hover'] = 'background:rgba(127,127,127,.25);';
$def['.ci-ico.on'] = 'color:var(--ci-accent);';
$def['.ci-ico svg'] = 'width:100%;height:100%;';
$def['.ci-grid'] = 'display:grid;grid-template-columns:1fr 1fr;gap:8px 10px;margin-bottom:10px;';
$def['.ci-grid .ci-field'] = 'position:relative;';
$def['.ci-field>span'] = 'position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--ci-dim);font-size:10px;pointer-events:none;';
$def['.ci-pair'] = 'display:flex;gap:6px;align-items:center;';
$def['.ci-sec-h'] = 'display:flex;align-items:center;justify-content:space-between;margin:14px 0 8px;padding-top:10px;border-top:1px solid var(--ci-line);color:var(--ci-dim);font-size:11px;font-weight:bold;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;user-select:none;';
$def['.ci-sec-h svg'] = 'width:12px;height:12px;transition:transform .15s;';
$def['.ci-sec.closed .ci-sec-h svg'] = 'transform:rotate(-90deg);';
$def['.ci-sec.closed .ci-sec-b'] = 'display:none;';
$def['.ci-row'] = 'display:flex;align-items:center;gap:8px;margin:6px 0;';
$def['.ci-row>label'] = 'flex:none;width:72px;';
$def['.ci-row.slider'] = 'display:grid;grid-template-columns:1fr 48px;gap:10px;';
$def['.ci-sub'] = 'display:flex;align-items:center;justify-content:space-between;margin:10px 0 6px;font-weight:bold;';
$def['.ci-fill'] = 'display:grid;grid-template-columns:18px 30px 1fr 56px;gap:8px;align-items:center;margin:6px 0;';
$def['.ci-swatch'] = 'width:30px;height:24px;border:1px solid var(--ci-line);border-radius:5px;cursor:pointer;padding:0;background-image:linear-gradient(45deg,#999 25%,transparent 25%,transparent 75%,#999 75%),linear-gradient(45deg,#999 25%,#fff 25%,#fff 75%,#999 75%);background-size:8px 8px;background-position:0 0,4px 4px;position:relative;overflow:hidden;';
$def['.ci-swatch i'] = 'position:absolute;inset:0;';
$def['.ci-title'] = 'font-weight:bold;margin:2px 0 8px;opacity:.85;';
$def['.ci-pop'] = 'position:fixed;z-index:1100;width:248px;box-sizing:border-box;padding:12px;background:var(--ci-pop);color:var(--ci-fg);border:1px solid var(--ci-line);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.45);font:12px sans-serif;';
$def['.ci-pop-head'] = 'display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;';
$def['.ci-pop-head .ci-ico'] = 'width:24px;height:24px;';
$def['.ci-pop h4'] = 'margin:0;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ci-dim);';
$def['.ci-sv'] = 'position:relative;height:130px;border-radius:5px;overflow:hidden;cursor:crosshair;touch-action:none;';
$def['.ci-sv canvas'] = 'width:100%;height:100%;display:block;';
$def['.ci-dot'] = 'position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;border:2px solid #fff;border-radius:50%;box-shadow:0 0 0 1px rgba(0,0,0,.5);pointer-events:none;';
$def['.ci-sliders'] = 'display:flex;gap:10px;align-items:center;margin:10px 0;';
$def['.ci-sliders>div:not(.ci-prev)'] = 'flex:1;display:flex;flex-direction:column;gap:8px;';
$def['.ci-prev'] = 'width:30px;height:30px;border-radius:50%;border:1px solid var(--ci-line);flex:none;';
$def['.ci-pop input[type=range]'] = '-webkit-appearance:none;appearance:none;height:10px;border-radius:5px;margin:0;width:100%;accent-color:initial;';
$def['.ci-pop input[type=range]::-webkit-slider-thumb'] = '-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:#fff;border:2px solid #333;box-shadow:0 0 0 1px #fff;';
$def['.ci-pop input[type=range]::-moz-range-thumb'] = 'width:12px;height:12px;border-radius:50%;background:#fff;border:2px solid #333;';
$def['.ci-hue'] = 'background:linear-gradient(90deg,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00);';
$def['.ci-vals'] = 'display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:6px;';
$def['.ci-vals div'] = 'text-align:center;color:var(--ci-dim);font-size:10px;';
$def['input[type=number]'] = '-moz-appearance:textfield!important;'; // firefox only: no spin buttons
$def['.ci-vals input'] = 'text-align:center;padding:6px 2px!important;';
$def['.ci-vals input[type=number]'] = '-moz-appearance:textfield;appearance:textfield;';
$def['.ci-vals input::-webkit-inner-spin-button, .ci-vals input::-webkit-outer-spin-button'] = '-webkit-appearance:none;margin:0;';

// + | ---------------------------------------------------------------------------
// + | styles that used to be set from the scripts (inline styles / cssText)
// + |
$def[".ce-flex1"] = "flex:1; min-width:0;";
$def[".ce-hide"] = "display:none;";
$def[".ce-num"] = "width:6em;";
$def[".ce-w3"] = "width:3em;";
$def[".ce-pointer"] = "cursor:pointer;";
$def[".ce-link"] = "color:inherit; font-weight:bold;";
$def[".ce-form-row"] = "display:flex; gap:8px; align-items:center; margin:8px 0;";
$def[".ce-form-lbl"] = "min-width:70px;";
$def[".ce-form-lbl.ce-wide"] = "min-width:110px;";
$def[".ce-about a"] = "color:inherit; text-decoration:underline;";
$def[".ce-chip"] = "position:absolute; z-index:30; display:flex; gap:6px; align-items:center; padding:6px; border-radius:6px; background:#2b2b2b; color:#eee; box-shadow:0 2px 8px rgba(0,0,0,.5); touch-action:manipulation;";
$def[".ce-chip-label"] = "width:110px;";
$def[".ce-chip-hint"] = "font:12px sans-serif; opacity:.8;";
$def[".ce-pl-note"] = "font-size:12px; opacity:.8;";
$def[".ce-pl-form"] = "display:flex; gap:6px; margin-top:10px;";
$def[".ce-pl-row"] = "display:flex; gap:8px; align-items:center; padding:4px 0;";
$def[".ce-layer-box"] = "border:1px solid var(--cm-line); border-radius:4px; padding:8px 12px; margin-bottom:10px;";
$def[".ce-pi-row"] = "display:flex; gap:8px; align-items:center; margin:6px 0;";
$def[".ce-pi-row > :first-child"] = "width:80px;";
$def[".cancas-modal .bd.bare"] = "padding:0; display:flex; flex:1; min-width:0;";
$def[".ce-sc-note"] = "font-size:12px; opacity:.75; margin:0 0 6px;";
$def[".ce-sc-info"] = "font-size:12px; color:#f0b429; min-height:1.4em; margin:6px 0;";
$def[".ce-sc-key"] = "min-width:130px; text-align:center;";
$def[".ce-sc-mini"] = "padding:4px 8px;";
$def[".ce-sc-row"] = "margin:5px 0;";
$def[".ce-sc-lbl"] = "width:200px;";
$def[".ce-sc-head"] = "font-weight:bold; margin:14px 0 4px; opacity:.85;";
$def[".ce-sc-all"] = "margin-top:14px;";
// present mode (tools/PresentMode.js)
$def[".cancas-present"] = "position:fixed; inset:0; z-index:99999; background:#111; display:flex; flex-direction:column; align-items:center; justify-content:center; touch-action:none;";
$def[".cp-canvas"] = "display:block; max-width:calc(100vw - 40px); max-height:calc(100vh - 96px); width:auto; height:auto; background:#fff; box-shadow:0 10px 40px rgba(0,0,0,.6);";
$def[".cp-stage"] = "position:relative; line-height:0;";
$def[".cp-hotlayer"] = "position:absolute; left:0; top:0; right:0; bottom:0;";
$def[".cp-header"] = "position:fixed; top:0; left:0; right:0; height:56px; display:flex; align-items:center; justify-content:space-between; padding:0 12px; box-sizing:border-box; z-index:1; background:linear-gradient(rgba(0,0,0,.55), transparent);";
$def[".cp-btn"] = "width:36px; height:36px; flex:none; border-radius:18px; border:0; background:rgba(255,255,255,.15); color:#fff; font-size:16px; cursor:pointer;";
$def[".cp-title"] = "color:#fff; font:14px sans-serif; opacity:.9; cursor:pointer; padding:6px 10px; border-radius:14px; max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;";
$def[".cp-title-edit"] = "font:14px sans-serif; padding:5px 10px; border-radius:14px; border:0; max-width:60%; text-align:center;";
$def[".cp-hot"] = "position:absolute; cursor:pointer; touch-action:manipulation;";
$def[".cp-link"] = "position:absolute; right:16px; padding:8px 16px; border-radius:20px; border:0; color:#fff; font:13px sans-serif; cursor:pointer; touch-action:manipulation; box-shadow:0 2px 6px rgba(0,0,0,.4);";
// inspector helpers
$def[".ci-propl"] = "width:100px;";
$def[".ci-mt6"] = "margin-top:6px;";
$def[".ci-mt8"] = "margin-top:8px;";
$def[".ci-mt10"] = "margin-top:10px;";
$def[".ci-mt12"] = "margin-top:12px;";
$def[".ci-pair.ci-pair-end"] = "justify-content:flex-end; margin:-4px 0 6px;";
$def[".ci-field.ci-w90"] = "width:90px;";
$def[".ci-fill.ci-notoggle"] = "grid-template-columns:30px 1fr 56px;";
$def[".ci-fill.ci-off, .ci-grid.ci-off"] = "opacity:.45;";
$def[".ci-sp6"] = "height:6px;";
$def[".ci-sp10"] = "height:10px;";
$def[".ci-chk"] = "display:flex; align-items:center; gap:6px; margin:6px 0;";
$def[".sf-sub.sf-shared"] = "padding:0 6px 4px 24px;";
$def[".cx-sec.cx-bare"] = "border:0; padding:0;";
$def[".cx-row.cx-mt8"] = "margin-top:8px;";
$def[".le-gap"] = "width:20px; flex:none;";
$def[".le-empty.le-empty-deep"] = "padding-left:52px;";
// startup loader fade out (the loader itself is styled in default.phtml)
$def["#cancas-loader.done"] = "opacity:0; pointer-events:none;";
// overlay layers
$def["{$editor} .debug"] = "bottom:0px; right:10px;";
$def["{$editor} .hostproperty"] = "display:none;";
$def["{$editor} .snippet-host"] = "pointer-events:none; top:0px; left:0px;";
$def["{$editor} .page-host"] = "pointer-events:none; top:0px; left:0px; bottom:0px; right:0px; overflow:hidden;";
$def["{$editor} .page-text"] = "font-size:8em; pointer-events:none;";
$def["{$editor} .gle-surface"] = "z-index:5; visibility:hidden;";
