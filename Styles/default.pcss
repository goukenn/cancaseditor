$def['.ps-h.dim'] = 'width:9px;height:9px;margin:-4px 0 0 -4px;cursor:pointer;';
$def['.ps-dot'] = 'position:absolute;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:50%;border:1px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.6);pointer-events:none;';
$def['.ps-chip'] = 'position:absolute;top:8px;left:50%;transform:translateX(-50%);display:flex;gap:2px;padding:2px;border-radius:14px;background:rgba(0,0,0,.6);pointer-events:all;';
$def['.ps-chip button'] = 'border:0;background:transparent;color:#ddd;padding:3px 12px;border-radius:12px;cursor:pointer;font:12px sans-serif;';
$def['.ps-chip button.on'] = 'background:#a14fd0;color:#fff;';

