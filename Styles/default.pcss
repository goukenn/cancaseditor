$def['.cx-out'] = 'flex:1 1 300px;min-width:0;';
$def['.cx-out textarea'] = 'width:100%;height:320px;box-sizing:border-box;font:12px/1.4 ui-monospace,Menlo,monospace;background:var(--cm-input,#111);color:var(--cm-fg,#eee);border:1px solid var(--cm-line,#444);border-radius:4px;padding:8px;resize:vertical;';
