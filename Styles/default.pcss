$def['.cancas-html-dlg .bar .sp'] = 'flex:1;';
$def['.cancas-html-dlg iframe, .cancas-html-dlg textarea'] = 'flex:1;border:0;width:100%;background:#fff;color:#000;';
$def['.cancas-html-dlg textarea'] = 'background:#111;color:#ddd;font:13px monospace;padding:8px;resize:none;box-sizing:border-box;';
$def['.cancas-html-dlg .props'] = 'display:flex;gap:8px;padding:6px 8px;background:#262626;font-size:12px;align-items:center;';
