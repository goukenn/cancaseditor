// + |
$def['.ps-host'] = 'position:absolute;left:0;top:0;right:0;bottom:0;pointer-events:none;z-index:6;overflow:hidden;';
$def['.ps-host svg'] = 'position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;';
$def['.ps-h'] = 'position:absolute;width:12px;height:12px;margin:-6px 0 0 -6px;box-sizing:border-box;border:2px solid #fff;border-radius:50%;background:#a14fd0;box-shadow:0 0 0 1px rgba(0,0,0,.65);cursor:move;pointer-events:all;touch-action:none;';
