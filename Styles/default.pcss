$def["{$editor} .surface .ce-cursor"] = "position: absolute; right: 10px; bottom: 8px; padding: 2px 10px; border-radius: 10px; background: rgba(0,0,0,.45); color: #eee; font-size: 11px; pointer-events: none; z-index: 5;";
$def["{$editor} .surface .ce-cursor:empty"] = "display: none;";
$xsm_screen["{$editor} .surface .ce-cursor"] = $sm_screen["{$editor} .surface .ce-cursor"] = "display: none;";
$def["{$editor}.touchable-device .surface .ce-cursor"] = "display: none;";
$def["{$editor} .surface:focus"] = "outline: none;";
