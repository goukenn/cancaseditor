$def["{$editor} .colortool .btn"] = "display:inline-block; width:16px; height:16px; border:1px solid black; background-color:white; ";
$def["{$editor} .colortool .btn.stroke"] = "{sys: posr} left: -4px; top: 4px; background-color:red;";
$def["{$editor}.touchable-device"] = "{sys:fith} padding:0px; padding-top:36px; padding-bottom: var(--igk-cancas-editor-app_menu-height, 32px);";
$def["{$editor}.touchable-device canvas"] = "overflow:scroll; padding-top:10px;";
$def["{$editor}.touchable-device div.tool.b"]= "{sys:dispn};"; 
$def[".pageLayer-contextMenu"] = "{sys:no-overflow} [trans: opacity 0.5s ease-out]; opacity: 1.0; z-index:110; top:0px; left: 100px; background-color: #444; [resolv: box-shadow: 0px 0px 4px]; border-radius: 10px;";
$def[".pageLayer-contextMenu:before"] = "{sys:posfix, loc-a} content:' '; opacity: 0.2; z-index: -1; background-color:black;";
$def[".pageLayer-contextMenu a"] = "{sys:dispb} padding: 10px 4px; padding-left: 32px;  font-size: 0.9em; cursor:pointer;";
$def[".pageLayer-contextMenu li"] = "{sys:dispb}";
$def[".pageLayer-contextMenu li:hover > a"] = "background-color: indigo; color:white; ";
$def[".pageLayer-contextMenu.igk-hide"] = "opacity: 0.0;"; 
$def[".canvas-editor-gui_dialog"] = "{sys:posfix, loc-a, dispflex} justify-content:center; align-items:center; z-index: 100;";
$def[".canvas-editor-gui_dialog:before"] = "{sys:posab, fit, loc-t, loc-l} content:' '; background-color:#222; opacity: 0.4; ";
$def[".canvas-editor-gui_dialog > div.box"] =  "{sys:dispib, loc-t} background-color: #fcfcfc; border:1px solid #dedede; ".
" box-shadow: 0 0 10px black;".
" padding:10px; border-radius: 10px; ";
$def[".canvas-editor-gui_dialog .title-bar"] = "font-family: [var: --igk-winui-bmc-typo]; {sys:no-selection} touch-action:none;";
$def[".canvas-editor-gui_dialog .title-bar .close"] = "cursor: pointer;";
$def[".canvas-editor-gui_dialog .box .content"] = "min-width:300px; line-height:1;";
$def["body > .dialog .igk-winui-bmc-group > div"] = "margin:4px 0px;";
$theme->registerKeyFrame($def, "igk-cancas-editor_notify-anim", " from { left: 50%; } to {left: 0px; }");
$def[".igk-cancas-editor_notifyhost"]="{sys:posab} right:8px; top:0px; max-width:min(300px, calc(100% - 16px));";
$def[".igk-cancas-editor_notify > .msg"] = "font-size:12pt; max-width:280px; line-height:15pt;";
$def[".igk-cancas-editor_notify"] = "(:.no-selection) [trans:opacity 0.2s ease-in, box-shadow 0.5s] [anim:igk-cancas-editor_notify-anim 0.2s linear]".
"opacity: 0.7; right:0; top: 0px; background-color:#444; line-height: 4em; color:#eee; padding:10px; padding-left:48px; margin-right: 10px; margin-top:10px; border-radius: 4px; touch-action:none; ";
$def[".igk-cancas-editor_notify:hover"] = "opacity : 1.0; box-shadow: 0 0 6px black;";
$def[".igk-cancas-editor_notify.igk-hide"] = "opacity : 0.0;";
$PTR["{$editor}"] = "display:none !important;";
$PTR[".igk-cancas-editor-options"] = "display:none !important;";
$def["{$editor}.touchable-device .snippet"] = "[transform:scale({$snippets['touch_size']},{$snippets['touch_size']})]";
$def["{$editor} .snippet"] = "{sys:posab}; pointer-events:all; cursor:pointer; z-index:{$snippetZIndex}; opacity: 0.5; [trans: opacity 0.2s ease-out];  width:1px; height:1px; transform-origin:center;".
" [transform: scale(10,10)]; background-color:skyblue; ";
$def["{$editor} .snippet:hover"]= "opacity:1.0; ";
$def["{$editor} .snippet.igk-hide"] = "opacity: 0.0;";
$def["{$editor} .snippet.round"] = "border-radius: 50%";
// transform snippets (selection): square = scale, diamond = skew, round + orange = rotation; they grow on hover
$def["{$editor} .snippet.rotate"] = "background-color: orange; cursor: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2224%22 height=%2224%22 viewBox=%220 0 24 24%22><path d=%22M5 15a8 8 0 0 1 3-8.5M19 15a8 8 0 0 0-3-8.5%22 fill=%22none%22 stroke=%22white%22 stroke-width=%225%22 stroke-linecap=%22round%22/><path d=%22M2.5 11l3.5 6 4-5zM21.5 11l-3.5 6-4-5z%22 fill=%22white%22 stroke=%22white%22 stroke-width=%223%22 stroke-linejoin=%22round%22/><path d=%22M5 15a8 8 0 0 1 3-8.5M19 15a8 8 0 0 0-3-8.5%22 fill=%22none%22 stroke=%22black%22 stroke-width=%222%22 stroke-linecap=%22round%22/><path d=%22M2.5 11l3.5 6 4-5zM21.5 11l-3.5 6-4-5z%22 fill=%22black%22/></svg>') 12 12, grab;";
$def["{$editor} .snippet.square, {$editor} .snippet.round"] = "[trans: opacity 0.2s ease-out, transform 0.15s ease-out]";
$def["{$editor}:not(.touchable-device) .snippet.square:hover, {$editor}:not(.touchable-device) .snippet.round:hover"] = "[transform: scale(13,13)]";
$def["{$editor} .snippet.losange"] = "[transform: rotate(45deg) scale(8)] width:1px; height:1px;";
$trans = $snippets['size']/ 2;
$def["body.safari .snippet" ] = "width:{$snippets['size']}px; height:{$snippets['size']}px;  [transform:translate(-{$trans}px, -{$trans}px)]";
$trans = $snippets['touch_size']/ 2;
$def["body.safari {$editor}.touchable-device .snippet" ] = "width:{$snippets['touch_size']}px; height:{$snippets['touch_size']}px; [transform:translate(-{$trans}px, -{$trans}px)] ";
$def["body.safari .snippet.round" ] = "";
$def["div.igk-default"] = "background-color: red; height: 800px;";
$def["div.canvas-editor-gui_dialog.dialog.color:before"] = "background-color:transparent; opacity:0.0;";
$def[".igk-tab-button"] = "{sys:dispib} font-size:0.62em";
$def[".igk-tab-button .igk-btn"] = "background-color:#444;{sys:no-selection}";
$def[".igk-tab-button .igk-btn.igk-active"] = "background-color:#eee; color:#444;";
