// + |
$def['.be-bar'] = 'position:relative;height:18px;border-radius:9px;margin:12px 6px 14px;cursor:copy;border:1px solid var(--ci-line,#4a4a4a);';
$def['.be-stop'] = 'position:absolute;top:-4px;width:14px;height:24px;margin-left:-7px;border:2px solid #fff;border-radius:4px;padding:0;cursor:ew-resize;box-shadow:0 0 0 1px rgba(0,0,0,.6);';
$def['.be-stop.on'] = 'border-color:var(--ci-accent,#a14fd0);box-shadow:0 0 0 2px var(--ci-accent,#a14fd0);';
$def['.be-row'] = 'display:flex;gap:8px;align-items:center;margin:6px 0;';
$def['.be-row>label'] = 'width:70px;flex:none;';
