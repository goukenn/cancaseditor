// + | ---------------------------------------------------------------------------
// + | property inspector (docked right on wide screens, see tools/PropertyInspectorTool.js)
// + |
$def["{$editor}.ci-docked"] = "padding-right: 280px;";
$def["{$editor} div.tool.r"] = "top: var(--igk-cancas-editor-app_menu-height, 32px); right: 0px; bottom: var(--igk-cancas-editor-app_menu-height, 32px); width: 280px; box-sizing: border-box; background-color: var(--cc-editor-bar); color: #ddd; overflow-y: auto; z-index: 50; display: none; font-size: 9pt;";
$def["{$editor} div.tool.r.ci-visible"] = "display: block;";
$def["{$editor} .ci-head"] = "display: flex; align-items: center; padding: 4px 8px; background-color: #333; font-weight: bold; position: sticky; top: 0px; z-index: 1;";
$def["{$editor} .ci-head-title"] = "flex: 1;";
$def["{$editor} .ci-close"] = "background: transparent; border: 0px; color: #ddd; font-size: 16px; cursor: pointer;";
$def["{$editor} .ci-body"] = "padding: 8px;";
$def["{$editor} .ci-title"] = "font-weight: bold; margin-bottom: 8px; opacity: 0.8;";
$def["{$editor} .ci-fab"] = "position: absolute; right: 8px; bottom: calc(var(--igk-cancas-editor-app_menu-height, 32px) + 8px); z-index: 60; padding: 8px 14px; border: 0px; border-radius: 18px; background-color: indigo; color: #fff; cursor: pointer; box-shadow: 0 0 6px black;";
$def["{$editor} .ci-panel input, {$editor} .ci-panel select"] = "max-width: 100%; box-sizing: border-box;";
$def[".cancas-modal .ci-title"] = "font-weight: bold; margin-bottom: 8px;";
// + | ---------------------------------------------------------------------------
// + | status bar (div.tool.b, see tools/StatusBarTool.js)
// + |
$def["{$editor} div.tool.b"] = "{sys:no-selection} top: auto; bottom: 0px; height: var(--igk-cancas-editor-app_menu-height, 32px); display: flex; align-items: center; padding: 0px 4px; white-space: nowrap; border-top: 1px solid #666;";
$def["{$editor} div.tool.b .sb"] = "display: inline-flex; align-items: center; gap: 12px; padding-left: 8px; margin-right: 12px;";
$def["{$editor} div.tool.b .sb-seg"] = "white-space: nowrap; flex: none;";
$def["{$editor} div.tool.b .sb-seg:empty"] = "display: none;";
$def["{$editor} div.tool.b .sb-warn"] = "color: #f0b429;";
$def["{$editor} div.tool.b .sb-cursor"] = "min-width: 7em;";
$xsm_screen["{$editor} div.tool.b .sb-opt"] = $sm_screen["{$editor} div.tool.b .sb-opt"] = "display: none;";
$def["{$editor}.touchable-device div.tool.b"] = "display: flex;";

// + | ---------------------------------------------------------------------------
// + | light theme (the dark one is the default). Attribute set on <html> by tools/SettingsDialog.js
// + |
$def["[data-theme=\"light\"] {$editor}"] = "--igk-cancas-editor-app_background: #e9ecea; --cc-editor-bar: #d3d8d5; --ce-surface-bg-color: #f5f5f5; color: #222;";
$def["[data-theme=\"light\"] {$editor} div.tool.t"] = "background-color: #d3d8d5;";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu li > a"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor}:not(.touchable-device) div.tool.t .menu li > a:hover"] = "color: #fff;";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu .submenu"] = "background-color: rgba(245,247,246,.98) !important; border: 1px solid rgba(0,0,0,.2); box-shadow: 0 6px 18px rgba(0,0,0,.25);";
$def["[data-theme=\"light\"] {$editor} div.tool.t .menu li.igk-disable a"] = "color: #888; background-color: transparent;";
$def["[data-theme=\"light\"] {$editor} div.b"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor} div.tool.r"] = "color: #222;";
$def["[data-theme=\"light\"] {$editor} .ci-head"] = "background-color: #c4cac7;";
$def["[data-theme=\"light\"] {$editor} .ci-close"] = "color: #222;";


$def[$editor.' .ce-drawer .ce-panel'] = '{sys:no-selection}';

// + | ---------------------------------------------------------------------------
// + | modal dialogs (moved from tools/UiModal.js); dark colors by default, [data-theme=light] overrides
// + |
$root['--cm-bg'] = '#2b2b2b';
$root['--cm-head'] = '#1e1e1e';
$root['--cm-side'] = '#232323';
$root['--cm-panel'] = '#333';
$root['--cm-fg'] = '#eee';
$root['--cm-btn'] = '#444';
$root['--cm-input'] = '#111';
$root['--cm-line'] = '#444';
$root['--cm-accent'] = '#5b4bd6';
$def['[data-theme="light"]'] = '--cm-bg:#dbe3df;--cm-head:#cfd8d4;--cm-side:#d9d9d9;--cm-panel:#d9d9d9;--cm-fg:#111;--cm-btn:#c4c9c7;--cm-input:#fff;--cm-line:#9aa5a0;--cm-accent:#4f2f8f;';
$def['.cancas-modal'] = 'position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);font:14px sans-serif;';
$def['.cancas-modal>div'] = 'background:var(--cm-bg);color:var(--cm-fg);width:min(560px,94vw);max-height:90vh;display:flex;flex-direction:column;border-radius:6px;overflow:hidden;';
$def['.cancas-modal .hd'] = 'display:flex;align-items:center;padding:8px 12px;background:var(--cm-head);font-weight:bold;';
$def['.cancas-modal .hd .sp'] = 'flex:1;';
$def['.cancas-modal .bd'] = 'padding:12px;overflow:auto;flex:1;';
$def['.cancas-modal button'] = 'background:var(--cm-btn);color:var(--cm-fg);border:0;padding:6px 12px;border-radius:4px;cursor:pointer;';
$def['.cancas-modal button.primary'] = 'background:var(--cm-accent);color:#fff;';
$def['.cancas-modal input[type=text], .cancas-modal input[type=url], .cancas-modal input[type=number], .cancas-modal select'] = 'background:var(--cm-input);color:var(--cm-fg);border:1px solid var(--cm-line);padding:4px 6px;border-radius:3px;min-width:0;';
$def['.cancas-modal.ce-settings>div'] = 'width:min(860px,96vw);height:min(520px,92vh);max-height:none;flex-direction:row;border-radius:0;border:1px solid var(--cm-line);';
$def['.ce-settings .ce-side'] = 'width:200px;flex:none;background:var(--cm-side);border-right:1px solid var(--cm-line);padding:8px 0;overflow:auto;';
$def['.ce-settings .ce-frame'] = 'display:flex;flex-direction:column;flex:1;min-width:0;';
$def['.ce-settings .ce-topbar'] = 'display:grid;grid-template-columns:1fr auto 1fr;align-items:center;flex:none;height:46px;padding:0 10px;background:var(--cm-head);border-bottom:1px solid var(--cm-line);';
$def['.ce-settings .ce-topbar .ce-title'] = 'grid-column:2;font-size:17px;font-weight:bold;text-align:center;white-space:nowrap;';
$def['.ce-settings .ce-topbar .ce-close'] = 'grid-column:3;justify-self:end;';
$def['.ce-settings .ce-wrap'] = 'display:flex;flex:1;min-width:0;min-height:0;';
$def['.ce-settings .ce-side h2'] = 'font:400 18px sans-serif;margin:0;padding:4px 12px 12px;';
$def['.ce-settings .ce-close'] = 'background:transparent;color:inherit;border:0;padding:0;width:30px;height:30px;line-height:0;cursor:pointer;border-radius:50%;opacity:.8;';
$def['.ce-settings .ce-close:hover'] = 'opacity:1;color:var(--cm-accent);';
$def['.ce-settings .ce-close svg'] = 'width:100%;height:100%;';
$def['.ce-settings .ce-side a'] = 'color:inherit;display:block;padding:10px 12px 10px 28px;font-size:18px;cursor:pointer;';
$def['.ce-settings .ce-side a.on'] = 'font-weight:bold;box-shadow:inset 3px 0 var(--cm-accent);';
$def['.ce-settings .ce-main'] = 'flex:1;display:flex;flex-direction:column;padding:10px;min-width:0;';
$def['.ce-settings .ce-page'] = 'flex:1;position:relative;background:var(--cm-panel);padding:16px;overflow:auto;';
$def['.ce-settings .ce-row'] = 'display:flex;align-items:center;gap:12px;margin:12px 0;';
$def['.ce-settings .ce-row>label'] = 'width:170px;flex:none;';
$def['.ce-settings .ce-cam'] = 'position:absolute;top:8px;right:8px;width:50px;height:50px;border-radius:50%;padding:0;background:#9a9a9a;display:flex;align-items:center;justify-content:center;overflow:hidden;';
$def['.ce-settings .ce-cam img'] = 'width:100%;height:100%;object-fit:cover;';
$def['.ce-settings .ce-foot'] = 'display:flex;justify-content:flex-end;padding-top:12px;';
$def['.ce-settings .ce-save'] = 'min-width:220px;padding:8px 24px;font-size:22px;border:3px solid var(--cm-accent);border-radius:22px;background:var(--cm-panel);color:var(--cm-fg);box-shadow:3px 3px 6px rgba(0,0,0,.35);';
$xsm_screen['.cancas-modal.ce-settings>div'] = $sm_screen['.cancas-modal.ce-settings>div'] = 'flex-direction:column;';
$xsm_screen['.ce-settings .ce-wrap'] = $sm_screen['.ce-settings .ce-wrap'] = 'flex-direction:column;';
$xsm_screen['.ce-settings .ce-side'] = $sm_screen['.ce-settings .ce-side'] = 'width:auto;display:flex;align-items:center;border-right:0;border-bottom:1px solid var(--cm-line);padding:0;';
$xsm_screen['.ce-settings .ce-side a.on'] = $sm_screen['.ce-settings .ce-side a.on'] = 'box-shadow:inset 0 -3px var(--cm-accent);';
$xsm_screen['.ce-settings .ce-side h2'] = $sm_screen['.ce-settings .ce-side h2'] = 'display:none;';
$xsm_screen['.ce-settings .ce-side a'] = $sm_screen['.ce-settings .ce-side a'] = 'padding:10px 16px;font-size:16px;';
$xsm_screen['.ce-settings .ce-row'] = $sm_screen['.ce-settings .ce-row'] = 'flex-wrap:wrap;';
$xsm_screen['.ce-settings .ce-save'] = $sm_screen['.ce-settings .ce-save'] = 'min-width:0;flex:1;';

