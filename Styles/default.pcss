// + | ---------------------------------------------------------------------------
// + | layer explorer (moved from tools/LayerExplorer.js)
// + |
$def['.le-root'] = 'font-size:12px;color:var(--ci-fg,#ddd);';
$def['.le-bar'] = 'display:flex;gap:6px;padding:2px 0 8px;border-bottom:1px solid var(--ci-line,#4a4a4a);margin-bottom:6px;';
$def['.le-bar button'] = 'background:transparent;border:1px solid var(--ci-line,#4a4a4a);color:inherit;border-radius:5px;padding:3px 8px;cursor:pointer;font:inherit;';
$def['.le-bar button:hover'] = 'background:rgba(127,127,127,.2);';
$def['.le-row'] = 'display:flex;align-items:center;gap:4px;padding:3px 4px;border-radius:4px;cursor:pointer;white-space:nowrap;';
$def['.le-row:hover'] = 'background:rgba(127,127,127,.18);';
$def['.le-row.active'] = 'background:rgba(161,79,208,.28);';
$def['.le-row.sel'] = 'outline:1px solid var(--ci-accent,#a14fd0);';
$def['.le-row .le-label'] = 'flex:1;overflow:hidden;text-overflow:ellipsis;';
$def['.le-row .le-sub'] = 'opacity:.55;font-size:10px;';
$def['.le-row.hidden .le-label'] = 'opacity:.45;text-decoration:line-through;';
$def['.le-ico'] = 'background:transparent;border:0;color:inherit;width:20px;height:20px;padding:2px;line-height:0;cursor:pointer;border-radius:3px;flex:none;';
$def['.le-ico:hover'] = 'background:rgba(127,127,127,.3);';
$def['.le-ico svg'] = 'width:100%;height:100%;';
$def['.le-ico.off'] = 'opacity:.45;';
$def['.le-empty'] = 'opacity:.6;padding:4px 8px;font-style:italic;';
$def['.le-row.drop-above'] = 'box-shadow:inset 0 2px 0 var(--ci-accent,#a14fd0);';
$def['.le-row.drop-below'] = 'box-shadow:inset 0 -2px 0 var(--ci-accent,#a14fd0);';
$def['.le-row.drop-into'] = 'outline:2px solid var(--ci-accent,#a14fd0);outline-offset:-2px;';
$def['.le-row.dragging'] = 'opacity:.4;';
$def['.le-row input.le-edit'] = 'flex:1;min-width:0;font:inherit;color:inherit;background:rgba(127,127,127,.2);border:1px solid var(--ci-accent,#a14fd0);border-radius:3px;padding:1px 4px;outline:none;';
$def['.le-menu'] = 'position:fixed;z-index:100000;min-width:150px;background:var(--ci-bg,#333);color:var(--ci-fg,#ddd);border:1px solid var(--ci-line,#4a4a4a);border-radius:6px;padding:4px;box-shadow:0 4px 14px rgba(0,0,0,.4);font-size:12px;';
$def['.le-menu div'] = 'padding:4px 10px;border-radius:4px;cursor:pointer;';
$def['.le-menu div:hover'] = 'background:rgba(127,127,127,.25);';
$def['.le-menu .le-sep'] = 'height:1px;padding:0;margin:4px 0;background:var(--ci-line,#4a4a4a);cursor:default;';

// + | ---------------------------------------------------------------------------
