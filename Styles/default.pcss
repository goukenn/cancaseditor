$def['.be-note'] = 'font-size:11px;color:#f0b429;margin:4px 0;';
$def['.be-tex'] = 'width:44px;height:44px;border:1px solid var(--ci-line,#4a4a4a);border-radius:5px;background-size:cover;flex:none;';

