	"packages" => function ($cmd = null) use ($query_options) {
		$fmt = igk_getv($query_options, "fmt", "json");
		if ($cmd == null) {
			igk_set_header(403);
			igk_exit();
		} else {
			$data = dirname(__FILE__) . "/Data/packages/";
			switch ($cmd) {
				case 'list':
					$file = $data . "/package.json";
					switch ($fmt) {
						case "xml":
							igk_header_set_contenttype("xml");
							if (igk_io_cache_file_exists($file)) {
								$d = igk_json_parse(igk_io_read_allfile($file));
								$pack = igk_create_node("packages");
								igk_xml_to_node($d, $pack);
								$pack->renderAJX();
							} else {
								igk_set_header(404);
								igk_wln(R::gets("package.json not found on this server"));
							}
							break;
						case "json":
						default:
							if (igk_io_cache_file_exists($file)) {
								igk_header_set_contenttype("json");
								igk_wl(igk_zip_output(igk_io_read_allfile($file)));
							} else {
								igk_set_header(404);
								igk_wln(R::gets("package.json not found on this server"));
							}
							break;
					}
					break;
			}
		}
		igk_exit();
	},
	"settings" => function () use ($ctrl) {
		// per-user editor options (authenticated users only): GET => {options, plugins}, POST options=<json {name: value}>
		$me = ($u = $ctrl->getUser()) ? $u->model() : null;
		igk_header_set_contenttype("json");
		if (!$me) {
			igk_set_header(401);
			igk_wl(json_encode(["error" => "login required"]));
			igk_exit();
		}
		$owner = $me->clGuid;
		if ($_SERVER["REQUEST_METHOD"] == "POST") {
			$data = json_decode(igk_getv($_POST, "options", "{}"), true);
			if (!is_array($data)) {
				igk_set_header(400);
				igk_wl(json_encode(["error" => "invalid options"]));
				igk_exit();
			}
			foreach ($data as $k => $v) {
				$k = (string)$k;
				if (!preg_match('/^[a-zA-Z][a-zA-Z0-9_.]{0,119}$/', $k)) {
					continue;
				}
				$v = is_scalar($v) ? (string)$v : json_encode($v);
				if (strlen($v) > 4096) {
					continue;
				}
				$cond = [CancasOptions::FD_OWNER => $owner, CancasOptions::FD_NAME => $k];
				if (CancasOptions::select_row($cond)) {
					CancasOptions::update([CancasOptions::FD_VALUE => $v], $cond);
				} else {
					CancasOptions::Insert(["name" => $k, "value" => $v, "owner" => $owner]);
				}
			}
		}
		$options = [];
		foreach (CancasOptions::select_all([CancasOptions::FD_OWNER => $owner]) ?: [] as $r) {
			$options[$r->{CancasOptions::FD_NAME}] = $r->{CancasOptions::FD_VALUE};
		}
		$plugins = [];
		foreach (CancasPlugins::select_all([CancasPlugins::FD_OWNER => $owner]) ?: [] as $r) {
			$plugins[] = [
				"id" => (int)$r->{CancasPlugins::FD_ID},
				"name" => $r->{CancasPlugins::FD_NAME},
				"url" => $r->{CancasPlugins::FD_URL},
				"enabled" => (int)$r->{CancasPlugins::FD_ENABLED}
			];
		}
		igk_wl(json_encode(["user" => $me->clLogin, "options" => (object)$options, "plugins" => $plugins]));
		igk_exit();
	},
	"plugins" => function () use ($ctrl) {
		// POST op=save (id?, name, url, enabled) | op=delete (id)
		$me = ($u = $ctrl->getUser()) ? $u->model() : null;
		igk_header_set_contenttype("json");
		if (!$me || $_SERVER["REQUEST_METHOD"] != "POST") {
			igk_set_header($me ? 405 : 401);
			igk_wl(json_encode(["error" => $me ? "method not allowed" : "login required"]));
			igk_exit();
		}
		$owner = $me->clGuid;
		$id = (int)igk_getv($_POST, "id", 0);
		if (igk_getv($_POST, "op") == "delete") {
			$id && CancasPlugins::delete([CancasPlugins::FD_ID => $id, CancasPlugins::FD_OWNER => $owner]);
			igk_wl(json_encode(["ok" => true]));
			igk_exit();
		}
		$name = trim((string)igk_getv($_POST, "name", ""));
		$url = trim((string)igk_getv($_POST, "url", ""));
		if (
			$name === "" || strlen($name) > 120 || strlen($url) > 500 ||
			!filter_var($url, FILTER_VALIDATE_URL) || !preg_match('#^https?://#i', $url)
		) {
			igk_set_header(400);
			igk_wl(json_encode(["error" => "invalid plugin"]));
			igk_exit();
		}
		$enabled = igk_getv($_POST, "enabled", 1) ? 1 : 0;
		if ($id) {
			CancasPlugins::update([
				CancasPlugins::FD_NAME => $name,
				CancasPlugins::FD_URL => $url,
				CancasPlugins::FD_ENABLED => $enabled
			], [CancasPlugins::FD_ID => $id, CancasPlugins::FD_OWNER => $owner]);
		} else {
			$item = CancasPlugins::Insert(["name" => $name, "url" => $url, "enabled" => $enabled, "owner" => $owner]);
			$id = $item ? (int)$item->{CancasPlugins::FD_ID} : 0;
		}
		igk_wl(json_encode(["ok" => true, "id" => $id]));
		igk_exit();
	},
	"surfaces" => function () use ($ctrl) {
		// surfaces saved on the account (connected users only).
		// GET => {quota, used, mine[], shared[], public[]} | GET id=<n> => the xml of a readable surface
		// POST op=save (name, content) | rename (id, name) | delete (id) | visibility (id, value) | share / unshare (id, login)
		require_once __DIR__ . "/Lib/Classes/Surfaces.php";
		$me = ($u = $ctrl->getUser()) ? $u->model() : null;
		if (!$me) {
			igk_header_set_contenttype("json");
			igk_set_header(401);
			igk_wl(json_encode(["error" => "login required"]));
			igk_exit();
		}
		if ($_SERVER["REQUEST_METHOD"] == "GET") {
			$id = (int)igk_getv($_GET, "id", 0);
			if ($id) {
				$r = Surfaces::readable($me, $id);
				if (!$r) {
					igk_set_header(404);
					igk_exit();
				}
				igk_header_set_contenttype("xml");
				igk_wl($r->{CancasSurfaces::FD_CONTENT});
				igk_exit();
			}
			igk_header_set_contenttype("json");
			igk_wl(json_encode(Surfaces::listAll($me)));
			igk_exit();
		}
		igk_header_set_contenttype("json");
		if ($_SERVER["REQUEST_METHOD"] != "POST") {
			igk_set_header(405);
			igk_wl(json_encode(["error" => "method not allowed"]));
			igk_exit();
		}
		$id = (int)igk_getv($_POST, "id", 0);
		switch (igk_getv($_POST, "op")) {
			case "save":
				$r = Surfaces::save($me, igk_getv($_POST, "name", ""), igk_getv($_POST, "content", ""));
				break;
			case "rename":
				$r = Surfaces::rename($me, $id, igk_getv($_POST, "name", ""));
				break;
			case "delete":
				$r = Surfaces::delete($me, $id);
				break;
			case "visibility":
				$r = Surfaces::setVisibility($me, $id, igk_getv($_POST, "value", ""));
				break;
			case "share":
			case "unshare":
				$r = Surfaces::share($me, $id, igk_getv($_POST, "login", ""), $_POST["op"] == "share");
				break;
			default:
				$r = ["error" => "unknown operation"];
		}
		if (isset($r["error"])) {
			igk_set_header($r["error"] == "quota" ? 403 : ($r["error"] == "not found" ? 404 : 400));
		}
		igk_wl(json_encode($r));
		igk_exit();
	},
	"store" => function () {}
), $params);



